# Production Environment
APP_ENV=production
DEBUG=false

# Database credentials
POSTGRES_USER=pdfglide
POSTGRES_PASSWORD=pdfglide2026secure
POSTGRES_DB=pdfglide

# Database URLs
DATABASE_URL=postgresql+asyncpg://pdfglide:pdfglide2026secure@postgres:5432/pdfglide
DATABASE_URL_SYNC=postgresql://pdfglide:pdfglide2026secure@postgres:5432/pdfglide

# Storage
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE=2147483648
FILE_EXPIRY_MINUTES=5
DELETE_AFTER_DOWNLOAD=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2
ENABLE_ASYNC_PROCESSING=true

# Security
SECRET_KEY=ce0092b7ea4a62f03aa110b6405035b9ad10715df9eea1e0f4d5be8f62b6da68

# Redis Security
REDIS_PASSWORD=redisSecure2026pdfglide

# AI Services (Z.ai)
ZAI_API_KEY=your-zai-api-key-here
ZAI_MODEL=glm-4.6v-flash
