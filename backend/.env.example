# ===========================================
# PDFGlide Backend Configuration
# ===========================================

# Application
APP_ENV=development  # development | production
DEBUG=true

# ===========================================
# SECURITY SETTINGS (IMPORTANT!)
# ===========================================

# API Key Authentication
# - Required in production
# - Optional in development (if not set, API is open)
# - Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=your-secure-api-key-here

# ===========================================
# DATABASE
# ===========================================

# PostgreSQL (REQUIRED - no default credentials!)
# IMPORTANT: Change username and password for production!
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/pdfglide
DATABASE_URL_SYNC=postgresql://your_user:your_password@localhost:5432/pdfglide

# For Docker deployment
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pdfglide
# DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/pdfglide

# ===========================================
# STORAGE
# ===========================================

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
FILE_EXPIRY_MINUTES=5
DELETE_AFTER_DOWNLOAD=true

# ===========================================
# DATA RETENTION (GDPR Compliance)
# ===========================================

# How long to keep uploaded input files (hours)
UPLOAD_RETENTION_HOURS=2

# How long to keep orphaned tasks without output files (hours)
ORPHAN_TASK_RETENTION_HOURS=24

# How long to keep usage statistics (days)
USAGE_STATS_RETENTION_DAYS=90

# How long to keep audit logs (days)
AUDIT_LOG_RETENTION_DAYS=365

# Enable/disable audit logging (recommended for GDPR compliance)
ENABLE_AUDIT_LOGGING=true

# ===========================================
# CORS (Cross-Origin Resource Sharing)
# ===========================================

# Add your frontend URL(s) here
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# For production, use your actual domain
# CORS_ORIGINS=["https://your-domain.com"]

# ===========================================
# RATE LIMITING
# ===========================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================
# Before deploying to production, ensure:
# 1. APP_ENV=production
# 2. DEBUG=false
# 3. API_KEY is set to a secure random value
# 4. DATABASE_URL uses secure credentials (not postgres:postgres)
# 5. CORS_ORIGINS only includes your actual frontend domain(s)
