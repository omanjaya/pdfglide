# ===========================================
# PDFGlide Docker Compose Configuration
# ===========================================
# Copy this file to .env and modify as needed
# cp .env.example .env

# ===========================================
# APPLICATION MODE
# ===========================================
APP_ENV=development  # development | production
DEBUG=true

# ===========================================
# DATABASE CREDENTIALS
# ===========================================
# IMPORTANT: For production, use secure credentials!
# Default credentials (postgres:postgres) are NOT allowed in production mode

# Development (default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdfglide

# Production example (uncomment and modify):
# POSTGRES_USER=pdfglide_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DB=pdfglide

# ===========================================
# API SECURITY
# ===========================================
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=your-secure-api-key-here

# ===========================================
# FILE SETTINGS
# ===========================================
MAX_UPLOAD_SIZE=104857600  # 100MB
FILE_EXPIRY_HOURS=1

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production with nginx proxy:
# NEXT_PUBLIC_API_URL=https://your-domain.com
